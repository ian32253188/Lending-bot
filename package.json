{
  "name": "bitfinex-lending-bot",
  "version": "1.0.0",
  "description": "Bitfinex 自動放貸機器人",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "client:install": "cd client && npm install",
    "client:build": "cd client && npm run build",
    "client:dev": "cd client && npm run dev",
    "build": "tsc -p server && npm run client:install && npm run client:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze:reoffer": "node server/analyze_reoffer.js"
  },
  "keywords": [
    "bitfinex",
    "lending",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "prom-client": "^15.1.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.61.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}