# Bitfinex API
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# Docker Compose 本機 PostgreSQL 資料庫設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lending_bot
# DATABASE_URL is only needed when connecting to an external PostgreSQL server.
# The Docker Compose files use PGHOST/PGPASSWORD and leave DATABASE_URL empty.
# DATABASE_URL=

# 系統管理員登入密碼 (網頁儀表板登入使用)
ADMIN_PASSWORD=

# 安全性 (必填)
JWT_SECRET=

# Telegram (選填)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# General
NODE_ENV=production
PORT=3000
TZ=Asia/Taipei

# Supabase (已棄用，僅供資料遷移 migrate 腳本使用)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_public_key

# OCI PostgreSQL 公開撮合資料保留天數
FUNDING_TRADE_RETENTION_DAYS=2
