# Bitfinex API
BITFINEX_API_KEY=your_bitfinex_api_key
BITFINEX_API_SECRET=your_bitfinex_api_secret

# 本地 PostgreSQL 資料庫設定 (Oracle VM 預設自建，無雲端磁碟 IO 限制)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=lending_bot
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/lending_bot

# 系統管理員登入密碼 (網頁儀表板登入使用)
ADMIN_PASSWORD=your_admin_dashboard_password

# 安全性 (必填)
JWT_SECRET=your_strong_random_secret_at_least_32_chars

# Telegram (選填)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# General
NODE_ENV=production
PORT=3000
TZ=Asia/Taipei

# Supabase (已棄用，僅供資料遷移 migrate 腳本使用)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_public_key

# OCI PostgreSQL 公開撮合資料保留天數
FUNDING_TRADE_RETENTION_DAYS=2
