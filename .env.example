# Bitfinex API (SaaS 模式下非必要，每位用戶在前端設定自己的金鑰)
# BITFINEX_API_KEY=your_api_key
# BITFINEX_API_SECRET=your_api_secret

# Supabase (必填)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_public_key

# Telegram (選填，SaaS 模式下用戶在前端設定自己的 Bot)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# 安全性 (必填)
JWT_SECRET=your_strong_random_secret_at_least_32_chars

# General
NODE_ENV=production
PORT=3000
TZ=Asia/Taipei

# Nginx & Let's Encrypt SSL (For Production)
DOMAIN_NAME=lendingbot.yourdomain.com
LETSENCRYPT_EMAIL=your-email@example.com
