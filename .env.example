# Bitfinex API
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# Docker Compose 本機 PostgreSQL 資料庫設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lending_bot
# Use DATABASE_URL for an external PostgreSQL server. The application,
# migration script, and research trainer enforce TLS with certificate and
# hostname validation for DATABASE_URL and non-local PGHOST connections.
# URL-encode reserved characters in the username/password. The Compose files
# use PGHOST/PGPASSWORD over the private Compose network and leave this empty.
# DATABASE_URL=

# 系統管理員登入密碼 (網頁儀表板登入使用)
ADMIN_PASSWORD=

# 安全性 (必填)
JWT_SECRET=

# Telegram (選填)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# General
NODE_ENV=production
PORT=3000
TZ=Asia/Taipei
# Use 0 for direct access; production Compose sets 1 for its single Nginx proxy.
TRUST_PROXY_HOPS=0

# 舊版 Supabase 相容／搬遷用途；新部署請使用 PostgreSQL。
# 舊 runtime fallback 會在讀寫 user_bot_settings 時將歷史明文憑證加密回存。
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_public_key

# OCI PostgreSQL 公開撮合資料保留天數
FUNDING_TRADE_RETENTION_DAYS=2
